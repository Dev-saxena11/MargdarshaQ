# Copy to .env for local development, or set these in the Render dashboard
# (Environment tab) for the deployed backend. NEVER commit a real key —
# .env is gitignored; .env.example (this file) holds placeholders only.

# ---------------------------------------------------------------------------
# AI Assistant — LLM provider (all optional)
# ---------------------------------------------------------------------------
# With none of these set, the assistant runs on its local deterministic engine.
# That path always works; it just can't answer free-form questions.
#
# Providers are tried in this order: OpenRouter, Gemini, OpenAI.

# OpenRouter — free models, no billing account required.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Defaults to "openrouter/free", an auto-router across whichever free
# models are currently available — so the assistant keeps working when any one
# free model is retired or rate-limited.
# MUST be a free model: "openrouter/free" or an id ending in ":free".
# A paid id is rejected at startup rather than silently billing the account.
OPENROUTER_MODEL=openrouter/free

# Alternatives (not free — only set if you have credit on these accounts)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated allowed origins. Defaults to "*" for local development; set
# the real frontend origin(s) in production. Include the local dev server here
# too, or a locally-served dashboard cannot call a deployed backend.
# e.g. https://sih-26137.vercel.app,http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGINS=*

# Optional regex matched against the whole Origin header; an origin is allowed
# if it matches CORS_ORIGINS *or* this pattern. Needed for hosts that mint a new
# hostname per deploy (Vercel preview/branch URLs), which cannot be listed
# ahead of time. Matched with fullmatch, so anchor-by-default — escape the dots.
# e.g. https://sih-26137-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# Required for PostgreSQL persistent storage.
# E.g. postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (JWTs) for user sessions.
# Generate a secure random string for production. Changing this will invalidate
# all currently issued tokens (logging everyone out).
JWT_SECRET=supersecret-logistics-key-change-in-prod

# OpenStreetMap / Overpass
# ---------------------------------------------------------------------------
# Where "draw a boundary on the map" sends its query.
#
# Unset (the default), the app races the three public Overpass mirrors. Those
# are shared and rate-limited by IP: the same bounding box measured 44s, then
# 169s, then a plain 502, all within one hour. Fine for development, a real risk
# in front of judges.
#
# For a demo, run a local instance and point this at it. See DEPLOYMENT.md for
# the full runbook and hardware requirements.
#   docker compose -f docker-compose.overpass.yml up -d
#   python scripts/check_overpass.py
# OVERPASS_URL=http://localhost:12345/api/interpreter

# Host port for the local instance, if 12345 is taken. Used by the compose file;
# remember to change OVERPASS_URL to match.
OVERPASS_PORT=12345

# Which regional .osm.pbf the local instance imports. Read by the compose file,
# not by the app. Smaller is dramatically faster to import — pick the smallest
# extract that covers everywhere you might draw a box.
#   City/district  ~50-200 MB   minutes to import     (use a BBBike extract)
#   Single zone    ~200-600 MB  ~15-40 min            see the zone note below
#   India-wide     ~1.3 GB      2h+, 20-30 GB disk    only if you need all of it
# Browse: https://download.geofabrik.de/asia/india.html
#
# Geofabrik's India zones are administrative, not compass directions. Bareilly
# (Uttar Pradesh) is in central-zone; Delhi is in northern-zone. Getting this
# wrong is quiet: a box outside the extract returns zero elements and falls
# back to the public API without complaining. Check the zone's .poly file if
# you are unsure, and confirm with scripts/check_overpass.py afterwards.
OSM_EXTRACT_URL=https://download.geofabrik.de/asia/india/central-zone-latest.osm.pbf

# Fall back to the public mirrors when the local instance does not answer.
# Defaults to on, so forgetting to start Docker costs latency rather than taking
# the feature down. Set to "off" during a rehearsal if you want a misconfigured
# local instance to fail loudly instead of hiding behind the public API.
# OVERPASS_PUBLIC_FALLBACK=on

# Seconds to wait on the local instance before falling back. A healthy local
# instance answers in under a second; this only bounds the damage when the
# container is up but wedged.
# OVERPASS_LOCAL_TIMEOUT=20
