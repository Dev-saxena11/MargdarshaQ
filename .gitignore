# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.pytest_cache/

# Secrets — real API keys live here and must never be committed.
# .env.example (placeholders only) is tracked deliberately.
.env
.env.*
!.env.example

# Node / frontend
node_modules/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Local runner helpers
powershell.bat

# Local scratch/debug scripts only.
# Do NOT ignore test_*.py or benchmark_*.py: the project's test suites live at
# the repo root (test_dynamic_correctness.py, test_assistant_providers.py,
# test_cors_config.py, test_dynamic_smoke.py) and app/core/benchmark_vrp.py is
# source. Ignoring those patterns silently refuses every newly added test —
# `git add test_foo.py` fails and the file never shows up in `git status`.
debug_*.py
scratch_*.py

# OSMnx Cache
cache/
